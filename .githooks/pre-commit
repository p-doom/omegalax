#!/usr/bin/env bash
# Pre-commit hook: verify staged Python files are ruff-clean (lint + format).
#
# Enable once per clone (shared across worktrees):
#     git config core.hooksPath .githooks
#
# Fix reported issues with:
#     uvx ruff check --fix <files>   # lint (auto-fixes the safe ones)
#     uvx ruff format <files>        # formatting
#
# Notes:
# * Only files staged for the current commit are checked, so the repo-wide
#   state is never re-scanned on every commit.
# * The working-tree version of each staged file is checked (the common case);
#   partially-staged files are checked as they appear on disk.
set -euo pipefail

# Pinned so the hook matches the repo-wide `style:`/lint baseline.
# Bump in lockstep with a fresh `uvx ruff@<ver> {check,format} omegalax scripts tests`.
RUFF_VERSION="0.15.15"

# Staged Python files: Added / Copied / Modified / Renamed (skip Deleted).
mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ ${#files[@]} -eq 0 ]; then
  exit 0
fi

if ! command -v uvx >/dev/null 2>&1; then
  echo "pre-commit: 'uvx' not found. Install uv: https://docs.astral.sh/uv/" >&2
  exit 1
fi

status=0

# 1. Lint (ruff defaults: pyflakes F + pycodestyle E4/E7/E9).
if ! uvx "ruff@${RUFF_VERSION}" check "${files[@]}"; then
  {
    echo
    echo "pre-commit: lint issues in staged files. Fix with:"
    echo "    uvx ruff@${RUFF_VERSION} check --fix ${files[*]}"
  } >&2
  status=1
fi

# 2. Formatting.
if ! uvx "ruff@${RUFF_VERSION}" format --check "${files[@]}"; then
  {
    echo
    echo "pre-commit: formatting issues in staged files. Fix with:"
    echo "    uvx ruff@${RUFF_VERSION} format ${files[*]}"
  } >&2
  status=1
fi

if [ "$status" -ne 0 ]; then
  {
    echo
    echo "then 'git add' the changes and commit again."
    echo "(bypass once with 'git commit --no-verify' if you must.)"
  } >&2
fi
exit "$status"
